# Frontend: leave empty to use the Vite proxy in development and Nginx in Docker.
VITE_API_URL=

# Backend
FINASSIST_DB_PATH=./finassist.db
RETRIEVAL_THRESHOLD=0.12
ENVIRONMENT=development

# Optional OpenAI-compatible Chat Completions provider. Leave LLM_API_KEY empty for deterministic mode.
# Set secrets only in the backend environment; never prefix them with VITE_.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=12
